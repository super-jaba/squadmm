# Copy to .env to override. Only OPENAI_API_KEY is needed (for real matching runs);
# everything else defaults to docker-compose.yml values.
DB_URL=postgres://squad:squad@localhost:5432/squad
# Recruiter payout rate when no RateAdjustment exists
DEFAULT_RATE_PERCENT=9
# LLM judge
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# How many recruiters are judged in parallel per role
MATCH_CONCURRENCY=5
